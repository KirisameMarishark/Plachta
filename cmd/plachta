#!/usr/bin/env bash

set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
VERSION_FILE="${ROOT_DIR}/VERSION"

get_version() {
    if [[ -f "${VERSION_FILE}" ]]; then
        cat "${VERSION_FILE}"
    else
        echo "unknown"
    fi
}

show_banner() {
    echo
    echo "Plachta $(get_version)"
    echo "Proxy Infrastructure Framework"
    echo
}

show_help() {
    show_banner

    cat <<EOF
Usage:
  plachta <command>

Commands:
  install      Install Plachta modules
  update       Update installed components
  doctor       Diagnose system status
  show         Show runtime information
  verify       Verify configuration
  backup       Backup configuration
  version      Show version
  help         Show this help
EOF
}

source "${ROOT_DIR}/lib/config.sh"
source "${ROOT_DIR}/lib/module.sh"
source "${ROOT_DIR}/lib/logger.sh"
source "${ROOT_DIR}/lib/error.sh"
source "${ROOT_DIR}/lib/prereq.sh"
source "${ROOT_DIR}/lib/service.sh"
source "${ROOT_DIR}/lib/package.sh"
export ROOT_DIR
source "${ROOT_DIR}/lib/metadata.sh"
source "${ROOT_DIR}/lib/system.sh"
source "${ROOT_DIR}/lib/download.sh"
source "${ROOT_DIR}/internal/show/reality.sh"
source "${ROOT_DIR}/internal/verify/reality.sh"
source "${ROOT_DIR}/internal/json.sh"

config_init
case "${1:-help}" in
    system)

    echo "Operating System : $(system_os)"
    echo "Version          : $(system_version)"
    echo "Architecture     : $(system_arch)"
    echo "Kernel           : $(system_kernel)"
    echo "Hostname         : $(system_hostname)"
    ;;
    version|-v|--version)
        echo "Plachta $(get_version)"
        ;;

    help|-h|--help)
        show_help
        ;;

    install)
    if [[ -z "${2:-}" ]]; then
        echo "Usage:"
        echo "  plachta install <module>"
        exit 1
    fi

    log_info "Installing module: $2"
    module_install "$2"
    log_success "Install finished."
    ;;

    update)
        echo "Update module (coming soon)"
        ;;

    doctor)
        echo "Doctor module (coming soon)"
        ;;

   verify)
    if [[ -z "${2:-}" ]]; then
        echo "Usage:"
        echo "  plachta verify reality"
        exit 1
    fi

    case "$2" in
        reality)
            verify_reality
            ;;
        *)
            module_verify "$2"
            ;;
    esac
    ;;
    
    show)
        case "${2:-}" in
            reality)
                show_reality
                ;;
            *)
                echo "Usage:"
                echo "  plachta show reality"
                ;;
        esac
        ;;
        
    config)
    case "${2:-show}" in
        show)
            cat "${CONFIG_FILE}"
            ;;
        get)
            config_get "$3"
            ;;
        set)
            config_set "$3" "$4"
            log_success "Configuration updated."
            ;;
        *)
            echo "Usage:"
            echo "  plachta config show"
            echo "  plachta config get <key>"
            echo "  plachta config set <key> <value>"
            ;;
    esac
    ;;
    modules)
        module_list
        ;;
    module-info)
    if [[ -z "${2:-}" ]]; then
        echo "Usage:"
        echo "  plachta module-info <module>"
        exit 1
    fi

    module_info "$2"
    ;;
    backup)
        echo "Backup module (coming soon)"
        ;;

    *)
        echo "Unknown command: $1"
        echo
        show_help
        exit 1
        ;;
esac