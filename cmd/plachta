#!/usr/bin/env bash

set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
VERSION_FILE="${ROOT_DIR}/VERSION"

get_version() {
    if [[ -f "${VERSION_FILE}" ]]; then
        cat "${VERSION_FILE}"
    else
        echo "unknown"
    fi
}

show_banner() {
    echo
    echo "Plachta $(get_version)"
    echo "Proxy Infrastructure Framework"
    echo
}

show_help() {
    show_banner

    cat <<EOF
Usage:
  plachta <command>

Commands:
  install      Install Plachta modules
  update       Update installed components
  doctor       Diagnose system status
  show         Show runtime information
  verify       Verify configuration
  backup       Backup configuration
  version      Show version
  help         Show this help
EOF
}

source "${ROOT_DIR}/lib/config.sh"
source "${ROOT_DIR}/lib/module.sh"
source "${ROOT_DIR}/lib/logger.sh"
source "${ROOT_DIR}/lib/error.sh"
source "${ROOT_DIR}/lib/prereq.sh"
source "${ROOT_DIR}/lib/service.sh"
source "${ROOT_DIR}/lib/package.sh"
export ROOT_DIR
source "${ROOT_DIR}/lib/metadata.sh"
source "${ROOT_DIR}/lib/system.sh"
source "${ROOT_DIR}/lib/download.sh"
source "${ROOT_DIR}/internal/show/reality.sh"
source "${ROOT_DIR}/internal/verify/reality.sh"
source "${ROOT_DIR}/internal/json.sh"
source "${ROOT_DIR}/internal/subscription/provider.sh"
source "${ROOT_DIR}/internal/subscription/providers/list.sh"
source "${ROOT_DIR}/internal/subscription/providers/reality.sh"
source "${ROOT_DIR}/internal/subscription/generate.sh"
source "${ROOT_DIR}/cmd/install.sh"
source "${ROOT_DIR}/cmd/show.sh"
source "${ROOT_DIR}/cmd/verify.sh"
source "${ROOT_DIR}/cmd/subscription.sh"
source "${ROOT_DIR}/cmd/config.sh"
source "${ROOT_DIR}/cmd/system.sh"
source "${ROOT_DIR}/cmd/modules.sh"
source "${ROOT_DIR}/cmd/module_info.sh"

config_init
case "${1:-help}" in
    system)
        cmd_system
        ;;
        
    version|-v|--version)
        echo "Plachta $(get_version)"
        ;;

    help|-h|--help)
        show_help
        ;;

    install)

        cmd_install "$@"

        ;;

    update)
        echo "Update module (coming soon)"
        ;;

    doctor)
        echo "Doctor module (coming soon)"
        ;;

    verify)

        cmd_verify "$@"

        ;;
    
    show)

        cmd_show "$@"

        ;;
    
    subscription)

        cmd_subscription "$@"

        ;;
        
        config)
        cmd_config "$@"
        ;;

    modules)
        cmd_modules
        ;;

    module-info)
        cmd_module_info "$@"
        ;;

    backup)
        echo "Backup module (coming soon)"
        ;;

    *)
        echo "Unknown command: ${1:-}"
        echo
        show_help
        exit 1
        ;;
esac