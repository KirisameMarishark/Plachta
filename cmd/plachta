#!/usr/bin/env bash

set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
VERSION_FILE="${ROOT_DIR}/VERSION"

get_version() {
    if [[ -f "${VERSION_FILE}" ]]; then
        cat "${VERSION_FILE}"
    else
        echo "unknown"
    fi
}

show_banner() {
    echo
    echo "Plachta $(get_version)"
    echo "Proxy Infrastructure Framework"
    echo
}

show_help() {
    show_banner

    cat <<EOF
Usage:
  plachta <command>

Commands:
  install      Install Plachta modules
  update       Update installed components
  doctor       Diagnose system status
  verify       Verify configuration
  backup       Backup configuration
  version      Show version
  help         Show this help
EOF
}

case "${1:-help}" in
    version|-v|--version)
        echo "Plachta $(get_version)"
        ;;

    help|-h|--help)
        show_help
        ;;

    install)
        echo "Install module (coming soon)"
        ;;

    update)
        echo "Update module (coming soon)"
        ;;

    doctor)
        echo "Doctor module (coming soon)"
        ;;

    verify)
        echo "Verify module (coming soon)"
        ;;

    backup)
        echo "Backup module (coming soon)"
        ;;

    *)
        echo "Unknown command: $1"
        echo
        show_help
        exit 1
        ;;
esac