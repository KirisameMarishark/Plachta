#!/usr/bin/env bash

set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
VERSION_FILE="${ROOT_DIR}/VERSION"

get_version() {
    if [[ -f "${VERSION_FILE}" ]]; then
        cat "${VERSION_FILE}"
    else
        echo "unknown"
    fi
}

show_banner() {
    echo
    echo "Plachta $(get_version)"
    echo "Proxy Infrastructure Framework"
    echo
}

show_help() {
    show_banner

    cat <<EOF
Usage:
  plachta <command>

Commands:
  install      Install Plachta modules
  update       Update installed components
  doctor       Diagnose system status
  verify       Verify configuration
  backup       Backup configuration
  version      Show version
  help         Show this help
EOF
}

source "${ROOT_DIR}/lib/config.sh"

config_init
case "${1:-help}" in
    version|-v|--version)
        echo "Plachta $(get_version)"
        ;;

    help|-h|--help)
        show_help
        ;;

    install)
        echo "Install module (coming soon)"
        ;;

    update)
        echo "Update module (coming soon)"
        ;;

    doctor)
        echo "Doctor module (coming soon)"
        ;;

    verify)
        echo "Verify module (coming soon)"
        ;;
    config)
    case "${2:-show}" in
        show)
            cat "${CONFIG_FILE}"
            ;;
        get)
            config_get "$3"
            ;;
        set)
            config_set "$3" "$4"
            echo "Saved."
            ;;
        *)
            echo "Usage:"
            echo "  plachta config show"
            echo "  plachta config get <key>"
            echo "  plachta config set <key> <value>"
            ;;
    esac
    ;;
    backup)
        echo "Backup module (coming soon)"
        ;;

    *)
        echo "Unknown command: $1"
        echo
        show_help
        exit 1
        ;;
esac